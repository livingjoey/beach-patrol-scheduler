# Copy to .env (or set in your hosting environment)
PORT=3000
DB_PATH=./data/beach-patrol.db
# Required in production: a long random string used to sign login tokens
AUTH_SECRET=
# Front-end origin allowed to call the API (e.g. http://localhost:5173). Leave empty to disable CORS.
CORS_ORIGIN=
TOKEN_TTL_HOURS=12
# Optional: password for the first admin (ADM01) created by `npm run seed`
SEED_ADMIN_PASSWORD=
# Required on the first-time setup screen when set (Render generates one for you)
SETUP_CODE=
# Serve the separate REST API under /api as well (off by default)
ENABLE_REST_API=false
